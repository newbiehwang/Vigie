# Claude Code 로컬 작업 폴더 (worktree, 세션 설정)
.claude/

# macOS 설치 마법사 앱 (installer/macos): XcodeGen과 SwiftPM이 만드는 파일
installer/macos/*.xcodeproj/
installer/macos/WGAInstallerKit/.build/
installer/macos/WGAInstallerKit/.swiftpm/
installer/macos/DerivedData/
# project.yml의 info·entitlements 설정으로 XcodeGen이 만드는 파일
installer/macos/WGAInstaller/Resources/Info.plist
installer/macos/WGAInstaller/Resources/WGAInstaller.entitlements

# 공식 MCP 도구 목록 스냅샷: 이미지를 만들 때 생긴다 (mcp/Dockerfile, mcp/lambda_mcp/official.py)
