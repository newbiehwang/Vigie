# AWS 관련 설정 파일
.aws/
aws.json
aws-credentials.json

# 환경 설정 파일 (루트 .env에 Anthropic API 키 등 비밀 값을 둔다)
.env
.env.*
*.env
# 예제 파일은 올린다 (값 없이 이름과 설명만)
!.env.example
env/
venv/
ENV/
env.bak/
venv.bak/
.python-version

# 파라미터 파일 (민감한 정보 포함)
parameters-*.json
!parameters-example.json  # 예제는 포함

# 개발 도구 관련 파일
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

