# Vigie 환경 값. 이 파일을 복사해 저장소 루트에 .env로 만들어 쓴다 (cp .env.example .env).
# .env는 git에 올리지 않는다 (.gitignore). 이 예제 파일에는 값을 적지 않는다.

# ---------------------------------------------------------------- 직접 적는 값
# Anthropic API 키 (https://console.anthropic.com/settings/keys).
# deploy.sh가 배포할 때 SSM Parameter Store의 /vigie/<env>/ANTHROPIC_API_KEY(SecureString)로 올리고,
# LLM Lambda는 SSM에서 읽는다. 비워 두면 SSM에 이미 있는 값을 그대로 쓴다.
# 프론트엔드에는 들어가지 않는다: 브라우저 번들에는 frontend/vite.config.ts가 고른 아래 값만 들어간다.
ANTHROPIC_API_KEY=

# 선택. deploy.sh·설치 도구가 명령 앞의 환경 변수(ADMIN_EMAIL=… ./deploy.sh dev)가 없을 때 이 값을 쓴다.
# 관리자 계정 이메일: 배포할 때 admins·approvers 그룹에 넣는다. 없는 계정이면 만들고 임시 비밀번호가 든 초대 메일을 보낸다.
# 일반 사용자는 로그인 페이지에서 스스로 가입한다
ADMIN_EMAIL=
# CloudWatch 알람을 받을 이메일 (구독 확인 메일의 링크를 눌러야 받는다)
ALARM_EMAIL=

# ---------------------------------------------------------------- deploy.sh가 채우는 값 (프론트엔드)
# 배포할 때 스택 출력값으로 채운다. 로컬 개발 서버(npm run dev)도 이 값으로 배포된 API·로그인을 쓴다.
# API Gateway 주소 (https://<id>.execute-api.<리전>.amazonaws.com/<env>)
VITE_API_DEST=
# Cognito 리전
AWS_REGION=
# Cognito User Pool ID
USER_POOL_ID=
# Cognito 앱 클라이언트 ID
COGNITO_CLIENT_ID=
# Cognito 도메인 앞부분 (<앞부분>.auth.<리전>.amazoncognito.com)
COGNITO_DOMAIN=
